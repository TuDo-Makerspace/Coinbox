        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-2" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;OTA&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Handles authenticated over-the-air firmware updates via HTTP.&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="1" vertex="1">
