        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-7" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Logger&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Wrapper around ESP logging that captures log output in an in-memory buffer while preserving normal console logging. The buffered logs can later be retrieved (e.g., for downloading from the settings menu).&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="5axI6qJwoJ98FT1Lp6Bq-49" vertex="1">
          <mxGeometry width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-9" value="&lt;font style=&quot;&quot;&gt;&lt;b style=&quot;font-size: 20px;&quot;&gt;Device Info&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Provides device information such as firmware/hardware version, MAC address, and recovery code.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="5axI6qJwoJ98FT1Lp6Bq-49" vertex="1">
          <mxGeometry x="600" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-11" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Runtime Status&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Provides a per-boot unique ID and a JSON runtime status response to keep track of the current session.&lt;/span&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="5axI6qJwoJ98FT1Lp6Bq-49" vertex="1">
          <mxGeometry x="335" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-51" value="" style="group" parent="1" vertex="1" connectable="0">
          <mxGeometry x="85" y="620" width="1050" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-16" value="&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Main Application&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;The main application web server handles the core Coinbox functionality. It primarily provides two pages: the Sounds page for managing sound files, and the Settings page for device configuration and diagnostics.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="5axI6qJwoJ98FT1Lp6Bq-51" vertex="1">
          <mxGeometry x="550" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5axI6qJwoJ98FT1Lp6Bq-17" value="&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Boostrap (Recovery)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 15px;&quot;&gt;Minimal recovery web server used as an entry point for the device. Provides a fallback interface if the user is locked out or the more complex main application becomes corrupted. Includes a countdown that automatically transitions to the main application if not interrupted.&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=middle;spacingTop=0;spacingLeft=10;spacingRight=10;spacingBottom=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" parent="5axI6qJwoJ98FT1Lp6Bq-51" vertex="1">
