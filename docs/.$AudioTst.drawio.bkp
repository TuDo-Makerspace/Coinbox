ont-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;communication_format&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #ff9da4;&quot;&gt;I2S_COMM_FORMAT_I2S_MSB&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;dma_buf_count&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #ffc58f;&quot;&gt;8&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;dma_buf_len&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #bbdaff;&quot;&gt;TONE_TABLE_LEN&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;use_apll&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #bbdaff;&quot;&gt;false&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;intr_alloc_flags&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #bbdaff;&quot;&gt;ESP_INTR_FLAG_LEVEL2&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;        .&lt;span style=&quot;color: #ff9da4;&quot;&gt;tx_desc_auto_clear&lt;/span&gt; &lt;span style=&quot;color: #99ffff;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #bbdaff;&quot;&gt;true&lt;/span&gt;,&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;    };&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap